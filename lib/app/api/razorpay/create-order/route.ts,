import { NextRequest, NextResponse } from 'next/server';
import Razorpay from 'razorpay';
import { z } from 'zod';
import { auth0 } from '@/lib/auth0';
import { MENU_ITEMS } from '@/lib/menu-data';

const razorpay = new Razorpay({
  key_id: process.env.NEXT_PUBLIC_RAZORPAY_KEY_ID!,
  key_secret: process.env.RAZORPAY_KEY_SECRET!,
});

const cartOrderSchema = z.object({
  items: z
    .array(
      z.object({
        id: z.string().min(1).max(50),
        quantity: z.number().int().min(1).max(20),
      })
    )
    .min(1)
    .max(30),
  orderType: z.enum(['dine-in-cottage', 'pickup', 'birthday-event']),
  customerNotes: z.string().max(250).optional(),
});

export async function POST(req: NextRequest) {
  try {
    const session = await auth0.getSession();
    if (!session?.user) {
      return NextResponse.json({ error: 'Please log in to place your order.' }, { status: 401 });
    }

    const body = await req.json();
    const parsed = cartOrderSchema.safeParse(body);
    if (!parsed.success) {
      return NextResponse.json({ error: 'Invalid cart items or order details.' }, { status: 400 });
    }

    const { items, orderType, customerNotes } = parsed.data;

    let totalRupees = 0;
    for (const cartItem of items) {
      const menuProduct = MENU_ITEMS.find((m) => m.id === cartItem.id);
      if (!menuProduct) {
        return NextResponse.json({ error: 'One or more selected menu items are invalid.' }, { status: 400 });
      }
      totalRupees += menuProduct.price * cartItem.quantity;
    }

    const order = await razorpay.orders.create({
      amount: totalRupees * 100,
      currency: 'INR',
      receipt: `hungryeyes_${Date.now()}`,
      notes: {
        userId: session.user.sub,
        userEmail: session.user.email || '',
        orderType,
        customerNotes: customerNotes || '',
      },
    });

    return NextResponse.json({
      orderId: order.id,
      amount: order.amount,
      currency: order.currency,
    });
  } catch (err) {
    console.error('Razorpay Order Error:', err);
    return NextResponse.json({ error: 'Could not process order right now. Please try again.' }, { status: 500 });
  }
}
